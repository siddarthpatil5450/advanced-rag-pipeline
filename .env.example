# Copy this file to .env (or just set these as real environment variables)
# before starting the server.

# Required for /admin/ingest (uploading new documents through the web UI).
# Without this set, admin actions are disabled but all read-only Q&A still works.
# PowerShell: $env:RAG_ADMIN_KEY = "choose-a-real-secret-here"
RAG_ADMIN_KEY=choose-a-real-secret-here
